# Only configure interactive shells.
case $- in
    *i*) ;;
    *) return ;;
esac

bashrc_fragment_dir="$HOME/.bashrc.d"

if [ -d "$bashrc_fragment_dir" ]; then
    for bashrc_fragment in "$bashrc_fragment_dir"/*.bash; do
        [ -r "$bashrc_fragment" ] && . "$bashrc_fragment"
    done
fi

unset bashrc_fragment bashrc_fragment_dir

# Local configuration is intentionally not managed by Dotbot.
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
