# Only configure interactive shells.
case $- in
    *i*) ;;
    *) return ;;
esac

if [[ -z ${_dotfiles_bashrc_loaded:-} ]]; then
    _dotfiles_bashrc_loaded=1
    _dotfiles_history_start_dir=$(builtin pwd -P) || _dotfiles_history_start_dir=
fi

set -o vi

bashrc_fragment_dir="$HOME/.bashrc.d"

if [ -d "$bashrc_fragment_dir" ]; then
    for bashrc_fragment in "$bashrc_fragment_dir"/*.bash; do
        [ -r "$bashrc_fragment" ] && . "$bashrc_fragment"
    done
fi

unset bashrc_fragment bashrc_fragment_dir

# Local configuration is intentionally not managed by Dotbot.
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

# Check the starting directory once, after local HISTFILE overrides are in place.
if [[ -n ${_dotfiles_history_start_dir:-} ]] && declare -F _dotfiles_enable_project_history >/dev/null; then
    _dotfiles_enable_project_history "$_dotfiles_history_start_dir" || :
fi
unset _dotfiles_history_start_dir
