# Copy this file to ~/.bashrc.local and customize it for each laptop.
# Dotbot intentionally does not manage that destination.

export WORK_ROOT="${WORK_ROOT:-$HOME/work}"

gowork() {
    cd "$WORK_ROOT" || return
}


